<?xml version="1.0" encoding="UTF-8"?>
<!--
  Production replication service: change capture from the legacy outbox, coalescing, apply to the
  new database, leases, fencing and metrics. Single subcommand: `worker`.
  Rule: this module never depends on the `poc` module (not even in test scope); enforced by the
  `enforce-worker-isolado` execution below and by IsolamentoWorkerTest.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.org.ecad</groupId>
    <artifactId>poc-replicacao-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>replicacao-worker</artifactId>
  <packaging>jar</packaging>

  <name>replicacao-worker</name>
  <description>Worker de replicação BDAD -&gt; banco novo (serviço de produção).</description>

  <dependencies>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-worker-isolado</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <!-- The production worker must not carry PoC code (any scope). -->
                    <exclude>br.org.ecad:replicacao-poc</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Publishes the shared integration-test helpers (oracle.BancosPoc) as a test-jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>test-jar</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Executable jar `replicacao-worker-<versão>-exec.jar`: `java -jar ... worker`.
           Attached with a classifier so the main artifact stays thin: the poc module depends
           on it without receiving a second copy of the JDBC driver. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>exec</shadedClassifierName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>br.org.ecad.poc.replicacao.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
