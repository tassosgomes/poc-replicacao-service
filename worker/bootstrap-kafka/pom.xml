<?xml version="1.0" ?>
<!--
  Executable of the Kafka alternative: same coordination (lease and fence in the destination), same
  sink and metrics as `bootstrap`, but the source is KafkaChangeSource and there is NO connection to
  the legacy database. Separate shaded jar: `replicacao-worker-kafka-<version>-exec.jar`.
  Reuses the public classes of `replicacao-worker` (Metricas) and `infra-oracle` (lease, fence, sink)
  without changing them.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>br.org.ecad</groupId>
    <artifactId>replicacao-worker-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>replicacao-worker-kafka</artifactId>
  <packaging>jar</packaging>
  <name>replicacao-worker-kafka</name>
  <description>Worker de replicação Kafka (Debezium) -&gt; banco novo.</description>
  <dependencies>
    <dependency>
      <groupId>br.org.ecad</groupId>
      <artifactId>replicacao-application</artifactId>
    </dependency>
    <dependency>
      <groupId>br.org.ecad</groupId>
      <artifactId>replicacao-infra-oracle</artifactId>
    </dependency>
    <dependency>
      <groupId>br.org.ecad</groupId>
      <artifactId>replicacao-infra-kafka</artifactId>
    </dependency>
    <!-- Metricas (CSV of the windows) is public in the bootstrap of the lab Java and reused as is. -->
    <dependency>
      <groupId>br.org.ecad</groupId>
      <artifactId>replicacao-worker</artifactId>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-worker-isolado</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>br.org.ecad:replicacao-poc</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>exec</shadedClassifierName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>br.org.ecad.poc.replicacao.bootstrap.kafka.Main</mainClass>
                  <!-- Jackson 3 ships multi-release jars. -->
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
