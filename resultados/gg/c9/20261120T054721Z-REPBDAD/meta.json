    "MAP bdad.obra_musical, TARGET replica.obra_musical, KEYCOLS (codigo), &",
    "  COMPARECOLS (ON UPDATE KEYINCLUDING (origem_updated_at)), &",
    "  RESOLVECONFLICT (UPDATEROWEXISTS, (DEFAULT, USEMAX (origem_updated_at))), &",
    "  COLMAP (USEDEFAULTS, origem_updated_at = updated_at, &",
    "    excluido = @IF(@STREQ(@GETENV('GGHEADER','OPTYPE'),'DELETE'), 1, excluido), &",
