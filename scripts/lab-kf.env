# Alvo do lab Kafka (alternativa A) para os runners compartilhados (sem segredos).
# Uso: set -a; source scripts/lab-kf.env; set +a
LAB_HOST_LEGADO=desenv-server
LAB_HOST_NOVO=infra-server
LAB_CONTAINER_LEGADO=kf-legado
LAB_CONTAINER_NOVO=kf-novo
LAB_PORTA_LEGADO=1525
LAB_PORTA_NOVO=1526
LAB_PORTA_INTERNA=1521
LAB_SERVICO=FREEPDB1
LAB_USUARIO_LEGADO=bdad
LAB_USUARIO_NOVO=replica
LAB_REDE=kf-rede
LAB_PREFIXO=kf-
RESULTADOS_BASE=resultados/kf
