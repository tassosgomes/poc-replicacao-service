    {
      "id": "te139",
      "type": "text",
      "x": 1112,
      "y": 2775,
      "width": 743.6800000000001,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
