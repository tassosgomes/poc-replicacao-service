    {
      "id": "te11",
      "type": "text",
      "x": 32,
      "y": 595,
      "width": 743.6800000000001,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
